# ── Required ──

# Bot token from @BotFather (never share it!)
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use /admin
# (each user can get their ID from this bot with /id)
ADMIN_IDS=

# ── Optional ──

# SQLite database path (default: data/seminar.db)
# DATABASE_PATH=

# Run mode: polling (default) or webhook
# BOT_MODE=polling

# Webhook mode only — public HTTPS URL and port of this host
# WEBHOOK_URL=https://example.com
# WEBHOOK_PORT=8443

# NOTE (reminders): schedule logic uses the server's local time.
# On an Iranian VPS run: sudo timedatectl set-timezone Asia/Tehran
